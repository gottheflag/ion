{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"emitDeclarationOnly": false,

		"outDir": "dist",
		"rootDir": "src",
		
		"declaration": false,
		
		"sourceMap": false,
		"removeComments": true
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}